{
  "name": "wattson-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "openapi": "openapi-typescript ../docs/openapi.json -o src/lib/openapi.d.ts",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "perf": "node scripts/lighthouse.mjs",
    "screenshots": "SCREENSHOTS=1 playwright test --project=docs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.46.0",
    "maplibre-gl": "5.24.0",
    "openapi-fetch": "0.14.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "lighthouse": "12.8.2",
    "openapi-typescript": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
